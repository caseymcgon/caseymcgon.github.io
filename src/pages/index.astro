---
import Base from '../layouts/Base.astro';import {Image} from 'astro:assets';import TripCard from '../components/TripCard.astro';import {publishedTrips,visiblePhotos} from '../lib/content';import {site} from '../config';
const trips=await publishedTrips();const photos=await visiblePhotos();const featured=trips.find(t=>t.data.featured)||trips[0];const cover=photos.find(p=>p.id===featured?.data.coverId);const selected=photos.filter(p=>p.data.selected).slice(0,3);
---
<Base><section class="home-intro wrap"><p class="eyebrow"><span class="tiny-sun">✳</span> OUTSIDE, MOSTLY</p><h1>Good places.<br/>A few <em>field notes.</em></h1><div class="intro-bottom"><p>{site.intro}</p><a class="text-link" href="/trips/">Explore the trips <span>↗</span></a></div></section>{featured&&cover&&<section class="featured wrap"><a class="hero-photo" href={`/trips/${featured.id}/`}><Image src={cover.data.src} alt={cover.data.alt} widths={[700,1200,1800,2400]} sizes="(max-width: 1200px) 100vw, 1200px" loading="eager" fetchpriority="high"/><div class="hero-overlay"><span class="eyebrow">LATEST FIELD NOTES · {featured.data.period}</span><h2>{featured.data.title}</h2><span class="hero-read">Read the report <span>↗</span></span></div></a><div class="under-photo"><span>01 / A little further from the everyday</span><span>{featured.data.tags.join(' · ')}</span></div></section>}<section class="section wrap"><div class="section-heading"><div><p class="eyebrow">THE JOURNAL</p><h2>From the trail.</h2></div><a class="text-link" href="/trips/">All trip reports ↗</a></div><div class="journal-grid">{trips.slice(0,2).map(trip=>{const photo=photos.find(p=>p.id===trip.data.coverId)!;return <TripCard trip={trip} photo={photo}/>})}<aside class="margin-note"><span class="tiny-sun">✳</span><p>A photograph, a few words,<br/>something to remember.</p><span>MORE NOTES TO COME</span></aside></div></section><section class="photo-section"><div class="wrap section"><div class="section-heading"><div><p class="eyebrow">THROUGH THE LENS</p><h2>The ones I kept.</h2></div><a class="text-link" href="/photos/">View selected photos ↗</a></div><div class="home-photo-grid">{selected.map(p=><a href="/photos/"><Image src={p.data.src} alt={p.data.alt} widths={[400,700,1000]} sizes="(max-width: 650px) 100vw, 33vw" loading="lazy"/></a>)}</div><p class="small-note">A growing collection of light, landscapes, and little moments.</p></div></section></Base>
