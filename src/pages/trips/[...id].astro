---
import {render} from 'astro:content';import {Image} from 'astro:assets';import Base from '../../layouts/Base.astro';import Gallery from '../../components/Gallery.astro';import {publishedTrips,visiblePhotos} from '../../lib/content';
export async function getStaticPaths(){return (await publishedTrips()).map(trip=>({params:{id:trip.id},props:{trip}}));}
const {trip}=Astro.props;const {Content}=await render(trip);const photos=(await visiblePhotos()).filter(p=>p.data.trip===trip.id);const cover=photos.find(p=>p.id===trip.data.coverId)!;
---
<Base title={trip.data.title} description={trip.data.description} image={cover.data.src.src}><article><header class="report-heading wrap"><a class="back-link" href="/trips/">← All trip reports</a><p class="eyebrow">{trip.data.period} <span> / </span> {trip.data.location}</p><h1>{trip.data.title}</h1><p class="report-deck">{trip.data.description}</p><div class="tags">{trip.data.tags.map(tag=><span>{tag}</span>)}</div></header><div class="wrap report-cover"><Image src={cover.data.src} alt={cover.data.alt} widths={[700,1200,1800,2400]} sizes="(max-width:1200px) 100vw, 1200px" loading="eager"/></div><div class="prose wrap"><Content/></div><section class="wrap report-gallery"><div class="section-heading"><div><p class="eyebrow">THE PHOTO ROLL</p><h2>Along the way.</h2></div><span class="small-note">{photos.length} photographs · click to enlarge</span></div><Gallery photos={photos}/></section><div class="wrap report-end"><a class="text-link" href="/trips/">← Back to the journal</a><a class="text-link" href="/photos/">Selected photos ↗</a></div></article></Base>
